  "ui_texts": [
    // チェックの報酬表示。例：Aliceへのアイアンクラッド：カード報酬。
    // English: {loc.Value.ItemDisplayName} for {loc.Value.Player.Name}
    "{player_name}に{item_name}",
    // 取得済みチェックの報酬名。例：アイアンクラッド：カード報酬（受取済み）。
    // English: {_location?.ItemDisplayName ?? locationName} (Claimed)
    "{item_name}（受取済み）",
    // メインメニューまたはラン中のポーズメニューのボタン。
    // English: Play
    "プレイ",
    // メインメニューまたはラン中のポーズメニューのボタン。
    // English: Game Settings
    "ゲーム設定",
    // メインメニューまたはラン中のポーズメニューのボタン。
    // English: Archipelago Settings
    "Archipelago設定",
    // メインメニューまたはラン中のポーズメニューのボタン。
    // English: Install APWorld
    "APWorldをインストール",
    // メインメニューまたはラン中のポーズメニューのボタン。
    // English: Mod Website & YAML Builder
    "Modサイト・YAML作成",
    // メインメニューまたはラン中のポーズメニューのボタン。
    // English: Quit
    "終了",
    // キャラクター選択画面の進捗一覧の見出し。
    // English: [gold]Checks Found[/gold]                                 [gold]Received Items[/gold]
    "[gold]発見したチェック[/gold]                                 [gold]受信アイテム[/gold]",
    // Archipelago接続画面のタイトル・入力欄・ボタン。
    // English: Archipelago Connection
    "Archipelago接続",
    // Archipelago接続画面のタイトル・入力欄・ボタン。
    // English: Slot Name:
    "スロット名：",
    // Archipelago接続画面のタイトル・入力欄・ボタン。
    // English: Enter your slot name...
    "スロット名を入力…",
    // Archipelago接続画面のタイトル・入力欄・ボタン。
    // English: Server URL:
    "サーバーURL：",
    // Archipelago接続画面のタイトル・入力欄・ボタン。
    // English: Password:
    "パスワード：",
    // Archipelago接続画面のタイトル・入力欄・ボタン。
    // English: (optional)
    "（任意）",
    // Archipelago接続画面のタイトル・入力欄・ボタン。
    // English: Close
    "閉じる",
    // Archipelago接続画面の接続処理中・成功・失敗の状態表示。
    // English: Connect
    "接続",
    // 接続ボタンを押したとき、必須の入力欄が空だった場合。
    // English: Please enter a slot name
    "スロット名を入力してください",
    // 接続ボタンを押したとき、必須の入力欄が空だった場合。
    // English: Please enter a server URL
    "サーバーURLを入力してください",
    // Archipelago接続画面の接続処理中・成功・失敗の状態表示。
    // English: Connecting...
    "接続中…",
    // Archipelago接続画面の接続処理中・成功・失敗の状態表示。
    // English: Connected successfully!
    "接続しました！",
    // Archipelago接続画面の接続処理中・成功・失敗の状態表示。
    // English: Failed to connect. Please check your details and try again.
    "接続できませんでした。入力内容を確認して、もう一度お試しください。",
    // キャラクター選択画面の目標表示。例：目標：3人のキャラクターで塔を踏破、進捗：1 / 3。
    // English: [gold]Goal: Slay the Spire with {charsToGoal} Characters[/gold]\nProgress: {GameUtility.GoaledCharactersCount} / {charsToGoal}
    "[gold]目標：{required_characters}人のキャラクターでスパイアを踏破[/gold]\n進捗：{completed_characters} / {required_characters}",
    // AP報酬一覧で受信済みのレリック報酬を表示するとき。
    // English: 現在のGitHubソースに対応する文言なし（ローカル版と実装が異なる）。
    "レリックを選択",
    // AP報酬一覧でレリックの選択肢を生成できなかったとき。
    // English: 現在のGitHubソースに対応する文言なし（ローカル版と実装が異なる）。
    "レリックを選択できない",
    // AP報酬一覧で受信済みのレリック報酬を表示するとき。
    // English: 現在のGitHubソースに対応する文言なし（ローカル版と実装が異なる）。
    "エンシェントを選択",
    // AP報酬一覧でレリックの選択肢を生成できなかったとき。
    // English: 現在のGitHubソースに対応する文言なし（ローカル版と実装が異なる）。
    "エンシェントを選択できない",
    // AP報酬画面。残り報酬があれば「スキップ」、なければ「進む」。
    // English: 現在のGitHubソースに対応する文言なし（ローカル版と実装が異なる）。
    "Archipelago報酬！",
    // AP報酬画面。残り報酬があれば「スキップ」、なければ「進む」。
    // English: 現在のGitHubソースに対応する文言なし（ローカル版と実装が異なる）。
    "スキップ",
    // AP報酬画面。残り報酬があれば「スキップ」、なければ「進む」。
    // English: 現在のGitHubソースに対応する文言なし（ローカル版と実装が異なる）。
    "進む",
    // 他プレイヤーからバフを受信したときの通知。例：Bobから次のターン用に筋力が届いた！
    // English: [color=magenta]{info.Player}[/color] provides you [sine][color=yellow]{info.ItemDisplayName}[/color][/sine] for your next turn!
    "[color=magenta]{player_name}[/color]から次のターン用に[sine][color=yellow]{item_name}[/color][/sine]が届いた！"
  ],
  // 今回追加した表示文言。{...}は実行時に差し込む値。
  // sender・receiver・itemは実際には色やアニメーションの装飾を付けて表示する。新設した日本語通知には対応する固定の英文なし。
  "notifications": {
    // APの未発見アイテムのヒント。例：ヒント：AliceのレリックはBobの「サイレント：レリック報酬 2」にある。
    "hint": "ヒント：{receiver}の{item}は{sender}の「{location}」にある。",
    // 自分のロケーションで自分用のアイテムを発見したとき。例：筋力を入手した！（アイアンクラッド：カード報酬 1）
    "self_found": "{item}を入手した！（{location}）",
    // 他プレイヤーから通常アイテムを受信。バフは既存の「次のターン用に…」通知だけを表示する。例：Bobからレリックが届いた！（サイレント：レリック報酬 1）
    "item_received": "{sender}から{item}が届いた！（{location}）",
    // 他プレイヤー用のアイテムを送信。例：Aliceにカード報酬を送った！（アイアンクラッド：カード報酬 2）
    "item_sent": "{receiver}に{item}を送った！（{location}）",
    // エラー通知。差し込まれるエラー詳細の言語は呼び出し元による。
    // English: ⚠ Error: {errorMessage}
    "error": "⚠ エラー：{errorMessage}",
    // Death Linkに死亡理由がない場合の通知。例：Aliceが死亡した！ 理由がある場合は受信した理由をそのまま表示。
    // English: {death.Source} has died!
    "death_link": "[sine][color=red]{source}が死亡した！[/color][/sine]",
    // APの目標達成時。
    // English: Goal Complete! You have won....?
    "goal_complete": "目標達成！勝利……？"
  },
  // 今回追加した表示文言。{...}は実行時に差し込む値。
  "save_notifications": {
    // 対象の自動セーブでサーバーの保存コールバックが返ったとき。
    // English: [font_size=80]Game autosaved.[/font_size]
    "autosaved": "[font_size=40]自動セーブ完了。[/font_size]",
    // APセーブの読み込みに失敗したとき。
    // English: Failed to load checkpoint. The checkpoint was preserved.
    "checkpoint_load_failed": "チェックポイントの読み込みに失敗。セーブデータは保持されている。",
    // 読み込もうとしたAPセーブが見つからないとき。
    // English: The checkpoint could not be found.
    "checkpoint_not_found": "チェックポイントが見つかりませんでした。"
  },
  // 今回追加した表示文言。{...}は実行時に差し込む値。
  // 通知とAP報酬画面のStS2ロケーション表示に使用。characterには日本語のキャラクター名を差し込む。他ゲーム・未知の名前は原文を維持。
  "location_names": {
    // 例：アイアンクラッド：ラン開始。
    // English: {character} Press Start
    "Press Start": "{character}：ラン開始",
    // 例：アイアンクラッド：カード報酬 1。
    // English: {character} Card Reward {number}
    "Card Reward": "{character}：カード報酬 {number}",
    // 例：サイレント：レアカード報酬 2。
    // English: {character} Rare Card Reward {number}
    "Rare Card Reward": "{character}：レアカード報酬 {number}",
    // 例：ディフェクト：レリック報酬 3。
    // English: {character} Relic {number}
    "Relic": "{character}：レリック報酬 {number}",
    // 例：リージェント：ショップ枠 4。
    // English: {character} Shop Slot {number}
    "Shop Slot": "{character}：ショップ枠 {number}",
    // 例：アイアンクラッド：戦闘ゴールド 5。
    // English: {character} Combat Gold {number}
    "Combat Gold": "{character}：戦闘ゴールド {number}",
    // 例：サイレント：ポーション報酬 1。
    // English: {character} Potion Drop {number}
    "Potion Drop": "{character}：ポーション報酬 {number}",
    // 例：ディフェクト：第2章のボスゴールド。
    // English: {character} Boss Gold {number}
    "Boss Gold": "{character}：第{number}層のボスゴールド",
    // 例：ネクロバインダー：第1章の古代の存在。
    // English: {character} Ancient Act {number}
    "Ancient Act": "{character}：第{number}層のエンシェント",
    // 例：アイアンクラッド：12階に到達。
    // English: {character} Reached Floor {number}
    "Reached Floor": "{character}：{number}階に到達",
    // 例：サイレント：第2章の休憩所 1。
    // English: {character} Act {act} Campfire {number}
    "Campfire": "{character}：第{act}層の休憩所 {number}",
    // 例：リージェント：第3章のボス。
    // English: {character} Act {act} Boss
    "Boss": "{character}：第{act}層のボス",
    // カスタムキャラクターの名前部分。例：カスタムキャラクター1：ラン開始。
    // English: Custom Character {number}
    "custom_character": "MODキャラ{number}"
  },
  // 今回追加した表示文言。{...}は実行時に差し込む値。
  "reward_sender": {
    // AP報酬画面の送り主と発見場所。例：Bobから（サイレント：レリック報酬 1）。
    // English: from {data.SenderName} ({data.FoundLocation})
    "sender_location": "{sender}から（{location}）"
  }
}
